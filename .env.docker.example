# .env for running the demo with Docker only (see docker-compose.yml).
# The database, mail and APP_URL settings come from docker-compose.yml, which
# overrides whatever is set here, so this file only needs the app's own keys.

APP_ENV=local
APP_DEBUG=true
# Generated by install.sh (php artisan key:generate).
APP_KEY=

BACKPACK_THEME=backpack.theme-tabler

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# Change these when the default ports are taken on your machine.
#APP_PORT=8080
#APP_SSL_PORT=8443
#FORWARD_DB_PORT=3307
#FORWARD_MAILPIT_PORT=8025

# Credentials for the Backpack add-ons (repo.backpackforlaravel.com), used for
# the first composer install inside the container. An auth.json in the project
# root works too.
#COMPOSER_AUTH={"http-basic":{"backpackforlaravel.com":{"username":"you@example.com","password":"your-token"}}}
